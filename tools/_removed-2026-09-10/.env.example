# ------------------------------------------------------------------
# PT Maharani Prima — Environment Variables (Deployment Reference)
# ------------------------------------------------------------------
# This is a STATIC site: no build step, no runtime env access from JS.
# The variables below are documentation-only. They tell you which
# placeholders to replace BEFORE you deploy, or which env vars your
# host (Netlify / Vercel / Cloudflare Pages) can substitute at build
# time if you later add a build step.
#
# Never commit real secrets. Copy this file to `.env` locally if your
# tooling reads it, and add `.env` to `.gitignore`.
# ------------------------------------------------------------------

# ---- Google Analytics 4 --------------------------------------------
# Measurement ID from https://analytics.google.com → Admin → Data Streams
# Replace the placeholder in EVERY HTML file:
#   <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
#   gtag('config', 'G-XXXXXXXXXX', { anonymize_ip: true });
# Batch replace command (PowerShell, from repo root):
#   Get-ChildItem *.html | ForEach-Object {
#     (Get-Content $_) -replace 'G-XXXXXXXXXX','G-YOUR_REAL_ID' | Set-Content $_
#   }
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---- Sentry Error Monitoring (optional) ----------------------------
# DSN from https://sentry.io → Settings → Projects → Client Keys
# Replace in js/main.js line 5:
#   window.SENTRY_DSN = "https://YOUR_SENTRY_DSN@sentry.io/YOUR_PROJECT_ID";
# The conditional loader in main.js only fetches Sentry when the DSN is
# real — leaving the placeholder keeps the bundle lean and skips Sentry
# entirely (zero network cost).
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/YOUR_PROJECT_ID

# ---- Contact form recipient ---------------------------------------
# Used in js/main.js sendBeacon call and in mailto: links across the site.
# Change here first, then batch-replace in HTML:
#   Get-ChildItem *.html,js\*.js | ForEach-Object {
#     (Get-Content $_) -replace 'admin@maharaniprima.com','your@domain.com' | Set-Content $_
#   }
CONTACT_EMAIL=admin@maharaniprima.com

# ---- Application submission URL (Careers) --------------------------
# Every "Apply" button on career-*.html links here. Update in one place:
#   Get-ChildItem career-*.html,careers.html | ForEach-Object {
#     (Get-Content $_) -replace 'https://tinyurl.com/Loker-MaharaniPrima','https://your-form-url' | Set-Content $_
#   }
CAREERS_APPLY_URL=https://tinyurl.com/Loker-MaharaniPrima

# ---- Canonical domain ----------------------------------------------
# Used in <link rel="canonical">, og:url, JSON-LD, sitemap.xml.
# Update all four at once when the domain changes:
#   Get-ChildItem *.html,sitemap.xml | ForEach-Object {
#     (Get-Content $_) -replace 'maharaniprima.com','your-domain.com' | Set-Content $_
#   }
CANONICAL_DOMAIN=maharaniprima.com

# ------------------------------------------------------------------
# Host-level env vars (only if you deploy to Netlify / Vercel / CF Pages)
# ------------------------------------------------------------------
# NETLIFY_BUILD_BASE=
# VERCEL_ENV=
# NODE_VERSION=20
